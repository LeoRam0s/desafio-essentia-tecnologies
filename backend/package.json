{
  "name": "essential-tech",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:up": "docker compose --env-file .env -f ../docker-compose.yaml up -d mysql mongo redis",
    "db:down": "docker compose --env-file .env -f ../docker-compose.yaml rm --stop --force mysql mongo redis",
    "db:migrate": "prisma migrate dev --name init && prisma generate",
    "db:test:up": "npm run db:test:down && docker compose --env-file .env.test -f ../docker-compose.yaml up -d --wait --wait-timeout 120 mysql-test mongo-test",
    "db:test:down": "docker compose --env-file .env.test -f ../docker-compose.yaml rm --stop --force --volumes mysql-test mongo-test",
    "db:test:migrate": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy",
    "test:e2e": "trap 'npm run db:test:down' EXIT; npm run db:test:up && npm run db:test:migrate && node --env-file=.env.test ./node_modules/vitest/vitest.mjs --config vitest.config.e2e.ts --run",
    "test:unit": "node ./node_modules/vitest/vitest.mjs --config vitest.config.ts --run"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "mongoose": "^9.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
