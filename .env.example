# Development-only values for the complete Docker Compose stack.
NODE_ENV=development
PORT=3000
BACKEND_HOST_PORT=3000
FRONTEND_PORT=4200

DB_HOST=mysql
DB_PORT=3306
DB_USER=mysql
DB_PASSWORD=mysql
DB_NAME=essential-tech
DATABASE_URL=mysql://mysql:mysql@mysql:3306/essential-tech

MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_admin_password
MONGODB_DATABASE=essential-tech
MONGODB_URL=mongodb://mongo_admin:mongo_admin_password@mongo:27017/essential-tech?authSource=admin

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=redis

JWT_SECRET=local_docker_access_secret_change_me
JWT_REFRESH_SECRET=local_docker_refresh_secret_change_me
JWT_ACCESS_TOKEN_EXPIRES_IN=10800
JWT_REFRESH_TOKEN_EXPIRES_IN=2592000
